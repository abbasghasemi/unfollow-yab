<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <alpha
        android:duration="150"
        android:fromAlpha="0"
        android:toAlpha="1" />
    <scale
        android:duration="280"
        android:fromXScale="-0.5"
        android:fromYScale="-0.5"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="1.2"
        android:toYScale="1.2" />

    <scale
        android:duration="80"
        android:fromXScale="1.2"
        android:fromYScale="1.2"
        android:pivotX="50%"
        android:pivotY="50%"
        android:startOffset="280"
        android:toXScale="1"
        android:toYScale="1" />

    <rotate
        android:duration="180"
        android:fromDegrees="35"
        android:pivotX="50%"
        android:pivotY="50%"
        android:startOffset="180"
        android:toDegrees="0" />
</set>