<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/back_sheet_dialog"
    android:orientation="vertical"
    android:paddingBottom="3dp">

    <ghasemi.abbas.unfollowyab.components.roundedimageview.RoundedImageView
        android:id="@+id/pic"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="12dp"
        android:src="@mipmap/ic_launcher"
        app:riv_border_color="#353535"
        app:riv_border_width="2dp"
        app:riv_oval="true" />

    <ghasemi.abbas.unfollowyab.components.TextView
        android:id="@+id/full_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="29dp"
        android:layout_marginRight="10dp"
        android:layout_toRightOf="@+id/pic"
        android:gravity="center|left"
        android:padding="5dp"
        android:paddingRight="10dp"
        android:text="name"
        app:color="#3A3A3A" />

    <View
        android:id="@+id/view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/pic"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="3dp"
        android:background="#e2e2e2" />

    <ghasemi.abbas.unfollowyab.components.TextView
        android:id="@+id/white_list"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_below="@+id/view"
        android:layout_marginHorizontal="10dp"
        android:background="@drawable/selectable_item_background"
        android:drawableRight="@drawable/ic_round_list_24"
        android:drawablePadding="10dp"
        android:drawableTint="#3A3A3A"
        android:gravity="center|right"
        android:paddingRight="5dp"
        android:text="اضافه به لیست سفید"
        android:visibility="gone"
        app:color="#3A3A3A" />

    <ghasemi.abbas.unfollowyab.components.TextView
        android:id="@+id/open"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_below="@+id/unfollow"
        android:layout_marginHorizontal="10dp"
        android:background="@drawable/selectable_item_background"
        android:drawableRight="@drawable/ic_round_open_in_new_24"
        android:drawablePadding="10dp"
        android:drawableTint="#3A3A3A"
        android:gravity="center|right"
        android:paddingRight="5dp"
        android:text="بازکردن در اینستاگرام"
        android:visibility="gone"
        app:color="#3A3A3A" />

    <ghasemi.abbas.unfollowyab.components.TextView
        android:id="@+id/unfollow"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_below="@+id/white_list"
        android:layout_marginHorizontal="10dp"
        android:background="@drawable/selectable_item_background"
        android:drawableRight="@drawable/ic_round_person_24"
        android:drawablePadding="10dp"
        android:drawableTint="#3A3A3A"
        android:gravity="center|right"
        android:paddingRight="5dp"
        android:text="آنفالو"
        app:color="#3A3A3A" />

    <ghasemi.abbas.unfollowyab.components.TextView
        android:id="@+id/delete"
        style="@style/BackRedTextView"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_below="@+id/open"
        android:layout_marginHorizontal="10dp"
        android:drawableRight="@drawable/ic_delete"
        android:drawablePadding="10dp"
        android:gravity="center|right"
        android:paddingRight="5dp"
        android:text="حذف از برنامه (نه اینستاگرام)"
        android:visibility="gone"
        app:color="#E91E63" />
</RelativeLayout>